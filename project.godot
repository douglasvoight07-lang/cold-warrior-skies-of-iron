; Engine configuration file — Godot 4.x
; Edit via the Godot editor (Project > Project Settings) rather than directly.

config_version=5

[application]

config/name="Cold Warrior: Skies of Iron"
config/description="Arcade military flight sim — Vietnam era"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Config="*res://config.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true

[input]

; --- Flight controls (keyboard defaults) ---
; W/S  = pitch up/down   Q/E = roll left/right
; A/D  = yaw left/right  R/F = throttle up/down
; G    = afterburner     Space = fire weapon

